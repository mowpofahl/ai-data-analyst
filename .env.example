# Copy to .env.local for local development. In Vercel, set these under
# Project Settings → Environment Variables. Never commit a real key.

# Your Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: which Claude model answers questions (default: claude-sonnet-5-5).
# claude-opus-5-5 is the most capable, at about twice the cost per question.
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: which Claude model writes the suggested questions (default: claude-haiku-4-5).
# ANTHROPIC_SUGGEST_MODEL=claude-haiku-4-5
